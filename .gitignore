__pycache__/
*.pyc
*.pyo
.env
*.log

# API-ключи — никогда не в git
config.py

# Коммерчески чувствительная документация
MD WIKI/

# Next.js — ключи и сборка
ui/.env.local
ui/.next/
ui/node_modules/

# Локальные конфиги инструментов (специфичны для машины)
.claude/
.obsidian/

# Sensitive business data — sensitive ИНН, адреса, маппинг подрядчик→объекты.
# Шаблон: business_data.example.yaml (в git). Реальные данные — в Dropbox.
business_data.yaml

# Snippets — копии запросов из Supabase Studio, дублируют миграции
supabase/snippets/

# Telegram MTProto session — равноценна логину, никогда не в git
# Любой *.session (включая .tg_session_send.session) = логин в аккаунт
.tg_session
*.session
*.session-journal
telegram_whitelist.yaml

# Telegram app credentials (api_id) — реквизиты приложения, копия в Dropbox/_secrets
docs/telegram_app_credentials.md

# Дампы/бэкапы БД — бизнес-данные (ИНН, контакты) + раздувают репо. Не в git.
_archive/*.sql
_archive/backup_*.sql
